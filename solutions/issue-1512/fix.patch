+      access([integer_inlist_rewrite.id], [integer_inlist_rewrite.v]), partitions(p0)
+      is_index_back=false, is_global_index=false, 
+      range_key([integer_inlist_rewrite.id]), range(MIN ; MAX)always true
+explain basic select /*+ opt_param('inlist_rewrite_threshold', 1) */ id
+from integer_inlist_rewrite where v in (1,1,1,1);
+Query Plan
+=====================================================
+|ID|OPERATOR                 |NAME                  |
